# Required at runtime. Use the pooled Prisma Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opportunity_os?schema=public"
# Optional for CLI-only operations such as migrations and seed.
# Never use this direct connection for application traffic on Vercel.
DIRECT_URL=""

# Required: generate with `npm exec auth secret` (at least 32 random characters).
AUTH_SECRET=""
# Optional outside Vercel. Vercel is detected automatically by Auth.js.
AUTH_TRUST_HOST="true"
# Do not set AUTH_URL on Vercel: Auth.js derives every Preview/Production URL.
# On Prisma Compute or another self-hosted target, set its public HTTPS URL.
# AUTH_URL="https://your-app.prisma.build"

# Used only when you explicitly run `npm run db:seed`.
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional AI providers. The application works without them in deterministic mode.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-nano"
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="deterministic"

# Optional official WhatsApp Business integration (future phase).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
