generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  SAVED
  ANALYZED
  ARCHIVED
}

enum ApplicationStatus {
  SAVED
  ANALYZED
  RESUME_GENERATED
  APPLIED
  INTERVIEW
  TEST
  OFFER
  HIRED
  REJECTED
}

enum LeadStatus {
  NEW
  ANALYZED
  QUALIFIED
  CONTACTED
  REPLIED
  MEETING
  PROPOSAL
  WON
  LOST
  DO_NOT_CONTACT
}

enum WebsiteStatus {
  NO_WEBSITE
  GOOD
  NEEDS_IMPROVEMENT
  UNKNOWN
}

enum LeadSource {
  MANUAL
  GOOGLE_BUSINESS
  OPENSTREETMAP
  DIRECTORY
  REFERRAL
  IMPORT
  API
}

enum MessageStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  OPENED_EXTERNALLY
  SENT
  FAILED
}

enum CampaignStatus {
  DRAFT
  REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AIAnalysisType {
  JOB_EXTRACTION
  JOB_MATCH
  RESUME_GENERATION
  LEAD_OPPORTUNITY
  MESSAGE_GENERATION
  RESPONSE_CLASSIFICATION
}

enum RequirementLevel {
  REQUIRED
  DESIRABLE
}

enum MatchLevel {
  MATCHED
  PARTIAL
  MISSING
}

enum LeadActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_ANALYZED
  MESSAGE_GENERATED
  MESSAGE_APPROVED
  CONTACTED
  REPLIED
  MEETING_CREATED
  PROPOSAL_SENT
  WON
  LOST
  FOLLOW_UP_SET
  DO_NOT_CONTACT
}

enum SocialNetwork {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  OTHER
}

enum MessageChannel {
  WHATSAPP
  EMAIL
  INSTAGRAM
  MANUAL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  resumes       Resume[]
  jobs          Job[]
  applications  Application[]
  leads         Lead[]
  campaigns     Campaign[]
  conversations Conversation[]
  pipelineStages PipelineStage[]
  clients       Client[]
  aiAnalyses    AIAnalysis[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
}

model Resume {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("Currículo Mestre")
  summary     String?
  phone       String?
  city        String?
  state       String?
  portfolioUrl String?
  linkedinUrl String?
  githubUrl   String?
  isMaster    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences Experience[]
  education   Education[]
  skills      Skill[]
  projects    Project[]
  certifications Certification[]
  generatedResumes GeneratedResume[]
  matches      JobMatch[]
  @@index([userId, isMaster])
}

model Experience {
  id          String   @id @default(cuid())
  resumeId    String
  role        String
  company     String
  location    String?
  description String
  startedAt   DateTime?
  endedAt     DateTime?
  current     Boolean  @default(false)
  sortOrder   Int      @default(0)
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  @@index([resumeId, sortOrder])
}

model Education {
  id          String   @id @default(cuid())
  resumeId    String
  institution String
  course      String
  degree      String?
  startedAt   DateTime?
  endedAt     DateTime?
  description String?
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  @@index([resumeId])
}

model Skill {
  id        String  @id @default(cuid())
  resumeId  String
  name      String
  category  String?
  level     String?
  years     Float?
  resume    Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  @@unique([resumeId, name])
}

model Project {
  id          String  @id @default(cuid())
  resumeId    String
  name        String
  description String
  url         String?
  repositoryUrl String?
  technologies String[]
  resume      Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  @@index([resumeId])
}

model Certification {
  id          String    @id @default(cuid())
  resumeId    String
  name        String
  issuer      String
  issuedAt    DateTime?
  expiresAt   DateTime?
  credentialUrl String?
  resume      Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  @@index([resumeId])
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  title       String
  company     String?
  location    String?
  workMode    String?
  url         String?
  description String
  salary      String?
  source      String?
  publishedAt DateTime?
  status      JobStatus @default(SAVED)
  matchScore  Int?
  descriptionHash String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements JobRequirement[]
  matches     JobMatch[]
  generatedResumes GeneratedResume[]
  applications Application[]
  @@unique([userId, url])
  @@index([userId, status, createdAt])
  @@index([userId, company, title])
}

model JobRequirement {
  id          String           @id @default(cuid())
  jobId       String
  name        String
  category    String
  level       RequirementLevel @default(REQUIRED)
  normalized  String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchItems  JobMatchItem[]
  @@unique([jobId, normalized, category])
}

model JobMatch {
  id          String   @id @default(cuid())
  jobId       String
  resumeId    String
  score       Int
  summary     String?
  createdAt   DateTime @default(now())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  items       JobMatchItem[]
  @@index([jobId, createdAt])
}

model JobMatchItem {
  id            String     @id @default(cuid())
  jobMatchId    String
  requirementId String
  level         MatchLevel
  evidence      String?
  jobMatch      JobMatch   @relation(fields: [jobMatchId], references: [id], onDelete: Cascade)
  requirement   JobRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  @@unique([jobMatchId, requirementId])
}

model GeneratedResume {
  id          String   @id @default(cuid())
  resumeId    String
  jobId       String
  version     Int      @default(1)
  title       String
  content     Json
  sourceFacts Json
  createdAt   DateTime @default(now())
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications Application[]
  @@unique([resumeId, jobId, version])
}

model Application {
  id                String            @id @default(cuid())
  userId            String
  jobId             String
  generatedResumeId String?
  status            ApplicationStatus @default(SAVED)
  appliedAt         DateTime?
  nextActionAt      DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  generatedResume   GeneratedResume?  @relation(fields: [generatedResumeId], references: [id], onDelete: SetNull)
  @@unique([userId, jobId])
  @@index([userId, status])
}

model Lead {
  id            String        @id @default(cuid())
  userId        String
  name          String?
  businessName  String?
  niche         String?
  city          String?
  state         String?
  phone         String?
  whatsapp      String?
  instagram     String?
  facebook      String?
  website       String?
  googleBusiness String?
  websiteStatus WebsiteStatus @default(UNKNOWN)
  score         Int           @default(0)
  status        LeadStatus    @default(NEW)
  source        LeadSource    @default(MANUAL)
  sourceUrl     String?
  notes         String?
  contactAllowed Boolean      @default(true)
  doNotContact  Boolean       @default(false)
  lastContactAt DateTime?
  nextFollowUpAt DateTime?
  duplicateKey  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  socials       LeadSocial[]
  audits        LeadWebsiteAudit[]
  analyses      LeadAnalysis[]
  campaignLeads CampaignLead[]
  messages      Message[]
  conversations Conversation[]
  activities    LeadActivity[]
  client        Client?
  @@index([userId, status, score])
  @@index([userId, whatsapp])
  @@index([userId, businessName, city])
  @@index([userId, duplicateKey])
}

model LeadSocial {
  id          String        @id @default(cuid())
  leadId      String
  network     SocialNetwork
  url         String
  handle      String?
  isActive    Boolean?
  lastCheckedAt DateTime?
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@unique([leadId, network, url])
}

model LeadWebsiteAudit {
  id              String        @id @default(cuid())
  leadId          String
  status          WebsiteStatus
  url             String?
  hasCustomDomain Boolean?
  isReachable     Boolean?
  hasHttps        Boolean?
  mobileFriendly Boolean?
  responseTimeMs  Int?
  title           String?
  metaDescription String?
  hasContactCta   Boolean?
  hasWhatsapp     Boolean?
  performanceScore Int?
  seoScore        Int?
  rawEvidence     Json?
  checkedAt       DateTime      @default(now())
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, checkedAt])
}

model LeadAnalysis {
  id                 String   @id @default(cuid())
  leadId             String
  businessSummary    String?
  possibleNeed       String?
  recommendedService String?
  opportunityReason  String?
  suggestedApproach  String?
  sourceFacts        Json
  createdAt          DateTime @default(now())
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, createdAt])
}

model Campaign {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String?
  filters     Json?
  status      CampaignStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads       CampaignLead[]
  @@index([userId, status])
}

model CampaignLead {
  id          String   @id @default(cuid())
  campaignId  String
  leadId      String
  approvedAt  DateTime?
  contactedAt DateTime?
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages    Message[]
  @@unique([campaignId, leadId])
}

model Message {
  id             String        @id @default(cuid())
  leadId         String
  campaignLeadId String?
  conversationId String?
  channel        MessageChannel
  content        String
  status         MessageStatus @default(DRAFT)
  sourceFacts    Json?
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignLead   CampaignLead? @relation(fields: [campaignLeadId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  @@index([leadId, status])
}

model Conversation {
  id        String         @id @default(cuid())
  userId    String
  leadId    String
  channel   MessageChannel
  externalId String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages  Message[]
  @@index([userId, updatedAt])
}

model PipelineStage {
  id        String   @id @default(cuid())
  userId    String
  code      String
  label     String
  color     String?
  sortOrder Int
  active    Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, code])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  type      LeadActivityType
  title     String
  metadata  Json?
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, createdAt])
}

model Client {
  id          String   @id @default(cuid())
  userId      String
  leadId      String?  @unique
  name        String
  company     String?
  email       String?
  phone       String?
  projectType String?
  projectValue Decimal? @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}

model AIAnalysis {
  id           String         @id @default(cuid())
  userId       String
  type         AIAnalysisType
  entityType   String
  entityId     String
  provider     String
  model        String?
  inputHash    String?
  sourceFacts  Json
  result       Json
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, entityType, entityId, createdAt])
}
