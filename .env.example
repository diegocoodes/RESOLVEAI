# Required: PostgreSQL/Prisma Postgres connection string.
# Hosted databases normally require `sslmode=require`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opportunity_os?schema=public"

# Required: generate with `npm exec auth secret` (at least 32 random characters).
AUTH_SECRET="replace-with-a-long-random-secret"
# Required behind a reverse proxy. Vercel is detected automatically by Auth.js.
AUTH_TRUST_HOST="true"
# Required on Prisma Compute so Auth.js uses the public endpoint instead of
# the container's internal 0.0.0.0 address.
AUTH_URL="https://your-app.prisma.build"

# Optional AI providers. The application works without them in deterministic mode.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="deterministic"

# Optional official WhatsApp Business integration (future phase).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
